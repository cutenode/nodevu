{
	"name": "nodevu",
	"version": "0.0.1",
	"description": "comprehensive node.js version tooling",
	"scripts": {
		"lint": "oxlint --deny-warnings && oxfmt --check && docov && npm run lint:harden && npm run lint:rules && npm run lint:pack && npm run lint:workspaces && npm run lint:docs && npm run knip",
		"lint:write": "oxlint --fix && oxfmt",
		"lint:harden": "node --test tools/harden/test/*.test.mjs && harden check -p npm -l strict --json | node tools/harden/check.mjs",
		"lint:pack": "npm exec --ws -- publint --strict && npm exec --ws -- attw --pack .",
		"lint:workspaces": "node --test test/workspaces.test.mjs",
		"lint:docs": "node --test test/docs-examples.test.mjs",
		"coverage": "npm run coverage --ws --if-present",
		"test": "npm run test --ws",
		"docs": "doc-kit generate",
		"docs:dev": "doc-kit generate && sirv out --dev",
		"types": "tsc -b",
		"knip": "knip --treat-config-hints-as-errors",
		"lint:rules": "node --test tools/oxlint/nodevu/test/*.test.mjs"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cutenode/nodevu.git"
	},
	"keywords": [
		"node.js",
		"version"
	],
	"author": "Tierney Cyren <hello@bnb.im> (https://bnb.im/)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/cutenode/nodevu/issues"
	},
	"homepage": "https://github.com/cutenode/nodevu#readme",
	"workspaces": [
		"core",
		"static",
		"parsefiles",
		"oldest",
		"newest",
		"ranges",
		"aliases",
		"translate",
		"fetchindex",
		"opt",
		"fixtures"
	],
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.5",
		"@doc-kit/cli": "1.1.1",
		"@doc-kit/generator-react": "0.5.0",
		"@docov/cli": "0.1.1",
		"@lavamoat/harden": "0.8.1",
		"@oxlint/plugins": "1.89.0",
		"@types/node": "26.6.6",
		"@types/semver": "7.8.0",
		"knip": "6.44.1",
		"oxfmt": "0.74.0",
		"oxlint": "1.91.0",
		"publint": "0.3.25",
		"readme-assert": "10.1.3",
		"sirv-cli": "3.0.1",
		"typescript": "7.0.2",
		"undici": "8.12.4",
		"yaml": "2.9.1"
	},
	"overrides": {
		"hast-util-raw": "9.1.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "npm",
			"version": ">=11.17.0",
			"onFail": "error"
		}
	},
	"allowScripts": {
		"fsevents@2.3.3": false
	}
}
