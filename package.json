{
	"name": "nodevu",
	"version": "0.0.1",
	"description": "comprehensive node.js version tooling",
	"main": "index.js",
	"scripts": {
		"lint": "oxlint && oxfmt --check",
		"lint:write": "oxlint --fix && oxfmt",
		"coverage": "npm run coverage --ws --if-present",
		"test": "npm run test --ws",
		"updates": "npm run updates --ws",
		"types": "tsc -b"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cutenode/nodevu.git"
	},
	"keywords": [
		"node.js",
		"version"
	],
	"author": "Tierney Cyren <hello@bnb.im> (https://bnb.im/)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/cutenode/nodevu/issues"
	},
	"homepage": "https://github.com/cutenode/nodevu#readme",
	"workspaces": [
		"core",
		"static",
		"parsefiles",
		"oldest",
		"newest",
		"ranges",
		"aliases",
		"translate",
		"fetchindex",
		"opt"
	],
	"devDependencies": {
		"@oxlint/plugins": "1.89.0",
		"@types/luxon": "3.7.6",
		"@types/node": "22.20.5",
		"@types/semver": "7.8.0",
		"oxfmt": "0.74.0",
		"oxlint": "1.89.0",
		"typescript": "7.0.2"
	}
}
