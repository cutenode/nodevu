{
	"$schema": "./node_modules/knip/schema-jsonc.json",
	"ignore": [
		// generated from the JSDoc by `npm run types` and published through
		// each package's `types` field
		"*/types/**",
		// vendored oxlint plugin
		"tools/oxlint/anti-slop/**",
	],
	"workspaces": {
		".": {
			// `doc-kit generate` loads its config by name, and the config points
			// doc-kit at the theme by path
			"entry": ["doc-kit.config.mjs", "docs/theme/Navigation.jsx"],
			"ignoreDependencies": [
				// test/types.mts checks the published types through the workspace links
				"^@nodevu/",
				// only a JSDoc type in doc-kit.config.mjs, installed by @doc-kit/cli
				"@doc-kit/core",
				// test/fc-num-runs.mjs loads the fast-check of whichever module it runs
				// in, so the root doesn't need its own
				"fast-check",
			],
			// aliases doc-kit's React generator defines while it builds the site
			"ignoreUnresolved": ["^#theme/"],
		},
	},
}
