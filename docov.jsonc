{
	"$schema": "https://raw.githubusercontent.com/cutenode/docov/v0.2.1/docov.schema.json",
	"exclude": [
		"**/test/**",
		// generated from the JSDoc by `npm run types`, and TypeScript 7 leaves
		// @typedef descriptions out of them
		"*/types/**",
		// vendored oxlint plugin
		"tools/oxlint/anti-slop/**",
	],
	"threshold": 100,
	"requireDescription": true,
	// defines the JSDoc tags nodevu uses, so tsdoc-tags only flags unknown ones
	"tsdocConfig": "tsdoc.json",
	"rules": {
		"doc-markdown": "error",
		"empty-tag-description": "error",
		"informative-docs": "error",
		"param-names": "error",
		"require-param": "error",
		"require-returns": "error",
		"require-template": "error",
		"require-yields": "error",
		"summary-sentence": "error",
		"tsdoc-code": "error",
		"tsdoc-inline-tags": "error",
		"tsdoc-tags": "error",
		"valid-link": "error",
		// tsdoc-escapes, tsdoc-html, tsdoc-links and tsdoc-params stay off: they
		// hold blocks to TSDoc's grammar, which has no place for the JSDoc
		// {type}s `npm run types` builds the types from. require-throws stays off
		// while it counts a throw in an async function, which rejects instead
	},
}
